# =========================================================
# EduHub - Configuration Template (Vercel & Supabase)
# =========================================================

# 1. Supabase Credentials (Lấy từ Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. AI Assistant (Gemini API Key - Lấy từ Google AI Studio nếu muốn gọi qua Serverless / Client)
GEMINI_API_KEY=your-gemini-api-key-here
